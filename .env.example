# ==============================================================================
# TeleBooks - Exemplo de Variáveis de Ambiente
# ==============================================================================

# WEB (Next.js / Frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# API (FastAPI / Backend)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telebooks
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SENTRY_DSN=

# REGRA DE SEGURANÇA:
# O frontend nunca deve possuir credenciais privilegiadas.
# SUPABASE_SERVICE_ROLE_KEY e DATABASE_URL ficam apenas no backend.
